---
const email = "lorenadelejero14@gmail.com";
const place = "Calamba City, Laguna, Philippines";

// Get your own endpoint at formspree.io (free), then paste it here
const formAction = "https://formspree.io/f/meaalvrb";

const socials = [
  { label: "GitHub", href: "https://github.com/Lorena14-art/Portfolio" },
  { label: "LinkedIn", href: "https://www.linkedin.com/in/lorena-delejero/" },
  { label: "Facebook", href: "https://www.facebook.com/profile.php?id=61592590149228" },
];
---

<section id="contact" class="py-5">
  <h2 class="display-5 mb-5">Get in Touch</h2>

  <div class="row g-5">
    <!-- Left: contact details -->
    <div class="col-lg-5">
      <p class="lead mb-4">
        Have a project, an idea, or an opportunity? I'd love to hear from you.
      </p>

      <ul class="contact-list list-unstyled mb-4">
        <li>
          <span class="contact-label">Email</span>
          <a href={`mailto:${email}`}>{email}</a>
        </li>
        <li>
          <span class="contact-label">Location</span>
          <span>{place}</span>
        </li>
      </ul>

      <div class="d-flex flex-wrap gap-3 mb-4">
        {socials.map((s) => (
          <a href={s.href} target="_blank" rel="noopener noreferrer" class="contact-social">
            {s.label} ↗
          </a>
        ))}
      </div>

     <a href="/assets/resume.pdf" target="_blank" class="btn btn-outline-primary">Download resume</a>
    </div>

    <!-- Right: form -->
    <div class="col-lg-7">
      <form id="contactForm" class="contact-form" action={formAction} method="POST">
        <div class="row g-3">
          <div class="col-md-6">
            <label for="name" class="form-label">Name</label>
            <input type="text" id="name" name="name" class="form-control" required />
          </div>

          <div class="col-md-6">
            <label for="email" class="form-label">Email</label>
            <input type="email" id="email" name="email" class="form-control" required />
          </div>

          <div class="col-12">
            <label for="subject" class="form-label">Subject</label>
            <input type="text" id="subject" name="subject" class="form-control" />
          </div>

          <div class="col-12">
            <label for="message" class="form-label">Message</label>
            <textarea id="message" name="message" rows="5" class="form-control" required></textarea>
          </div>

          <!-- spam trap: real visitors never see or fill this -->
          <input type="text" name="_gotcha" class="d-none" tabindex="-1" autocomplete="off" />

          <div class="col-12">
            <button type="submit" class="btn btn-primary">Send message →</button>
            <p id="formStatus" class="mt-3 mb-0" role="status" aria-live="polite"></p>
          </div>
        </div>
      </form>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contactForm') as HTMLFormElement | null;
  const status = document.getElementById('formStatus');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!status) return;

    status.textContent = 'Sending…';

    try {
      const res = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });

      if (res.ok) {
        status.textContent = "Thank you! Your message was sent. I'll reply soon.";
        form.reset();
      } else {
        status.textContent = 'Something went wrong. Please try again or email me directly.';
      }
    } catch {
      status.textContent = 'Network error. Please try again or email me directly.';
    }
  });
</script>